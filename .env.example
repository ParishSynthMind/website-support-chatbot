# Copy to .env and fill in. .env is git-ignored. Real environment variables win over this file.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

COMPANY_NAME=Orbitly
# KNOWLEDGE_BASE_DIR=./knowledge_base
# DATABASE_PATH=./data/chatbot.sqlite3

# Guardrails
MAX_MESSAGE_CHARS=500
MAX_HISTORY_TURNS=6
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=100
# Only set true behind a proxy you control (Render, Fly, nginx), or X-Forwarded-For can be spoofed.
TRUST_PROXY_HEADERS=false
MONTHLY_SPEND_CAP_USD=20
PRICE_INPUT_PER_MTOK=2.00
PRICE_OUTPUT_PER_MTOK=10.00
# Comma-separated list of sites allowed to embed the widget, or *
ALLOWED_ORIGINS=*

# Handover notifications: console | smtp | slack (slack is a stub)
NOTIFIER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SLACK_WEBHOOK_URL=
