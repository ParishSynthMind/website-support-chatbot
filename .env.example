# Copy to .env and fill in. .env is git-ignored. Real environment variables win over this file.
# Which model answers: anthropic (Claude) | bedrock (Claude on AWS) | openai | gemini.
# Only the chosen provider's key is needed. bedrock needs no key here: it uses your AWS credentials
# (a profile, env vars or the Lambda role) plus AWS_REGION, e.g. eu-north-1.
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Leave blank for the provider's default: claude-sonnet-5-5, eu.anthropic.claude-haiku-5-5, gpt-6-luna
# or gemini-3.5-flash-lite
LLM_MODEL=

COMPANY_NAME=Orbitly
# KNOWLEDGE_BASE_DIR=./knowledge_base
# DATABASE_PATH=./data/chatbot.sqlite3

# Guardrails
MAX_MESSAGE_CHARS=500
MAX_HISTORY_TURNS=6
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=100
# Only set true behind a proxy you control (Render, Fly, nginx), or X-Forwarded-For can be spoofed.
TRUST_PROXY_HEADERS=false
MONTHLY_SPEND_CAP_USD=20
# USD per million tokens for the spend cap. Leave commented to use the chosen provider's list price.
# PRICE_INPUT_PER_MTOK=2.00
# PRICE_OUTPUT_PER_MTOK=10.00
# Comma-separated list of sites allowed to embed the widget, or *
ALLOWED_ORIGINS=*

# Handover notifications: console | smtp | slack (slack is a stub)
NOTIFIER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SLACK_WEBHOOK_URL=
